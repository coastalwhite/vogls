(DELAYFILE
  (SDFVERSION "3.0")
  (DIVIDER .)
  (TIMESCALE 1ns)

  (CELL
    (CELLTYPE "buf_cell")
    (INSTANCE top.u1)
    (DELAY
      (ABSOLUTE
        (IOPATH a b (1:1:1) (1:1:1))
      )
    )
  )

  (CELL
    (CELLTYPE "buf_cell")
    (INSTANCE top.u2)
    (DELAY
      (ABSOLUTE
        (IOPATH a b (1:1:1) (1:1:1))
      )
    )
  )

  (CELL
    (CELLTYPE "top")
    (INSTANCE top)
    (DELAY
      (ABSOLUTE
        (INTERCONNECT u1.b u2.a (3:3:3) (3:3:3))
      )
    )
  )
)
