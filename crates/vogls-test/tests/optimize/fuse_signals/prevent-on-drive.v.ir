signal[{mode}] a/0: 1
signal[{mode}] x/1: 1

proc assign {
*TR0:
  %t0 = tv.const 1'h0
  %t1 = vogls.black_box %t0
{?mode=fvO0}  %t2 = tvtofv %t1
{?mode=fvOn}  %t2 = tvtofv %t1
{?mode=fvO0}  drv $x/1, %t2
{?mode=fvOn}  drv $x/1, %t2
{?mode=tvO0}  drv $x/1, %t1
{?mode=tvOn}  drv $x/1, %t1
  halt
}

proc fuse {
*TR0:
  %t0 = prb $a/0
  drv $x/1, %t0
  watch [$a/0], <TR0>
}

