signal[{mode}] a/0: 1
signal[{mode}] x/1: 1

proc initial {
*TR0:
  waitregion 1, <TR1>
*TR1:
{?mode=fvO0}  %t0 = {!mode}.const 1'h1
{?mode=fvO0}  %t1 = tvtofv %t0
{?mode=fvO0}  drv $x/1, %t1
{?!mode=fvO0}  %t0 = {mode}.const 1'h1
{?!mode=fvO0}  drv $x/1, %t0
  halt
}

proc fuse {
*TR0:
  %t0 = prb $a/0
  drv $x/1, %t0
  watch [$a/0], <TR0>
}

