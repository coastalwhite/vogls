signal[tv] c: 1
signal[tv] d: 1

proc other {
*TR0:
    %t0 = prb $c
    %t1 = tv.const 1'b1
    %t2 = tv.const 1'b0
    %t3 = select %t0, %t1, %t2
    drv $d, %t3
    halt
}

proc other {
*TR0:
    %t0 = prb $c
    %t1 = tv.const 1'b0
    %t2 = tv.const 1'b1
    %t3 = select %t0, %t1, %t2
    drv $d, %t3
    halt
}
